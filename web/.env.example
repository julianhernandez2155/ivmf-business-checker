# Phase 00 Plan 04: copy to .env.local and fill with values from ivmf-checker-dev Supabase
# Settings → API → URL + anon + service_role keys.

# Public — embedded in client bundle. SAFE.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never inline in client code. NO NEXT_PUBLIC_ prefix.
# Used only by server actions / route handlers / middleware on the server side.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
