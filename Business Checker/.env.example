# Perplexity API Key
# Get your key at: https://www.perplexity.ai/settings/api
# Copy this file to .env and fill in your key below.

PERPLEXITY_API_KEY=your-key-here

# Perplexity sonar pricing — update these if Perplexity changes their rates
# Current rates: https://docs.perplexity.ai/guides/pricing
PERPLEXITY_COST_PER_REQUEST=0.005
PERPLEXITY_COST_PER_1M_TOKENS=1.00

# Result cache TTL in days (default: 30)
# After this period, businesses are re-checked on the next run.
# IVMF typically runs datasets months apart, so most entries expire naturally.
CACHE_TTL_DAYS=30
