# Worker environment template — copy to worker/.env (gitignored) and fill in.
# Phase 0 / Plan 02 — populated for schema integration tests + Plan 00-05 worker.

# CRITICAL: SUPABASE_DEV_DB_URL MUST be the direct postgres-user connection string
# (port 5432). The pooler URL (port 6543) routes through a non-postgres role that
# cannot toggle session_replication_role or bypass RLS — test fixtures will fail
# loudly via the _role_guard fixture in worker/tests/conftest.py.
# Format: postgres://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres
SUPABASE_DEV_DB_URL=postgres://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Required for the test_user fixture to create an auth.users row via admin API
# (Phase 0 plan 02 inserts directly via service-role bypass, but these are still
# the keys the Plan 00-05 worker uses for non-test paths).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Worker identity for worker_heartbeats (Plan 00-05 writes; Plan 02 schema only).
WORKER_ID=local-dev

# Plan 00-05 worker runtime knobs.
# DATABASE_URL is the live worker connection (Railway sets this to the same
# direct-postgres DSN as SUPABASE_DEV_DB_URL above). Kept separate so the
# Railway service can use a non-dev database in prod without renaming env vars.
DATABASE_URL=postgres://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Git SHA stamped into worker_heartbeats.version each cycle. Railway injects
# RAILWAY_GIT_COMMIT_SHA; locally default to "dev".
GIT_SHA=dev

# Python logging level (debug | info | warning | error). Default: info.
LOG_LEVEL=info
